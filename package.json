{
  "name": "shopify-app-changeguard",
  "version": "0.5.1",
  "description": "Unofficial offline semantic change review for Shopify app configuration files",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "changeguard": "dist/cli.js"
  },
  "scripts": {
    "prebuild": "node scripts/write-version.mjs",
    "build": "tsc -p tsconfig.json && ncc build dist/action.js -o dist/action --minify",
    "test": "npm run build && node --test",
    "check": "node dist/cli.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "coverage": "npm run build && c8 --include 'dist/*.js' --reporter=text --reporter=json-summary --check-coverage --lines 80 --functions 80 --branches 70 --statements 80 node --test",
    "format:check": "git diff --check",
    "package:check": "npm pack --dry-run",
    "package:smoke": "node scripts/package-smoke.mjs",
    "action:check": "node scripts/check-action-dist.mjs"
  },
  "dependencies": {
    "@iarna/toml": "2.2.5"
  },
  "devDependencies": {
    "@actions/core": "3.0.1",
    "@types/node": "26.6.3",
    "@vercel/ncc": "0.45.0",
    "c8": "12.0.0",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RexCode-Digital/shopify-app-changeguard.git"
  },
  "homepage": "https://github.com/RexCode-Digital/shopify-app-changeguard#readme",
  "bugs": {
    "url": "https://github.com/RexCode-Digital/shopify-app-changeguard/issues"
  },
  "keywords": [
    "shopify",
    "github-action",
    "configuration",
    "security",
    "toml",
    "ci"
  ],
  "publishConfig": {
    "provenance": true
  },
  "files": [
    "dist/cli.js",
    "dist/client-id.js",
    "dist/core.js",
    "dist/git-refs.js",
    "dist/pr-review.js",
    "dist/rule-catalog.js",
    "dist/summary.js",
    "dist/urls.js",
    "dist/webhooks.js",
    "dist/events.js",
    "dist/generated-version.js"
  ],
  "author": "Efe G\u00f6kdemir"
}
